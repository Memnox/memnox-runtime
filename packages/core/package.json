{
  "name": "@memnox/core",
  "version": "0.14.2",
  "description": "Memnox core domain: action events, agent identity, decisions, and store ports.",
  "keywords": [
    "ai-agents",
    "governance",
    "policy",
    "audit",
    "types"
  ],
  "license": "Apache-2.0",
  "author": "Memnox",
  "homepage": "https://github.com/Memnox/memnox/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Memnox/memnox.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Memnox/memnox/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/engine.ts src/wire.ts --format esm --dts --clean"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "smol-toml": "^1.8.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
