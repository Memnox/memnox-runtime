{
  "name": "@memnox/guard",
  "version": "0.14.2",
  "description": "Allow, ask or deny before each tool call of an agent running in the cloud, decided in its own process from the workspace's rules, with asks answered by a person.",
  "keywords": [
    "ai-agents",
    "governance",
    "approvals",
    "claude-agent-sdk",
    "security"
  ],
  "license": "Apache-2.0",
  "author": "Memnox",
  "homepage": "https://github.com/Memnox/memnox/tree/main/packages/guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Memnox/memnox.git",
    "directory": "packages/guard"
  },
  "bugs": {
    "url": "https://github.com/Memnox/memnox/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@memnox/core": "workspace:*"
  }
}
