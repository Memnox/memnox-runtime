{
  "version": 1,
  "bundle": {
    "hash": "vectors-1",
    "rules": [
      {
        "id": "no-refunds",
        "effect": "deny",
        "match": "mcp.stripe.create_refund",
        "reason": "refunds go through finance"
      },
      {
        "id": "ask-linear",
        "effect": "ask",
        "match": "mcp.linear.*",
        "reason": "a person checks tracker changes"
      },
      {
        "id": "reads-run",
        "effect": "allow",
        "match": "mcp.*.list_*"
      },
      {
        "id": "support-no-mail",
        "effect": "deny",
        "match": "tool.send_email",
        "agents": [
          "support-bot"
        ]
      },
      {
        "id": "ask-exports",
        "effect": "ask",
        "match": "tool.export_*",
        "targets": [
          "!internal"
        ]
      },
      {
        "id": "no-deploys",
        "effect": "deny",
        "match": "tool.deploy",
        "unless": [
          {
            "agents": [
              "release-bot"
            ]
          }
        ]
      },
      {
        "id": "watch-cleanup",
        "effect": "deny",
        "match": "tool.cleanup",
        "decision": {
          "effect": "deny",
          "mode": "observe"
        }
      },
      {
        "id": "admins-wipe",
        "effect": "allow",
        "match": "tool.wipe",
        "conditions": {
          "roles": [
            "admin"
          ]
        }
      },
      {
        "id": "no-wipe",
        "effect": "ask",
        "match": "tool.wipe"
      }
    ]
  },
